{
  "name": "agentkit",
  "version": "1.0.0",
  "description": "AgentKit — build AI agents on locally-trained brains (nanoGPT on TensorFlow.js), no LLM API needed",
  "type": "module",
  "bin": {
    "agentkit": "agentkit/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "agentkit": "node agentkit/cli.js",
    "test": "node --test test/agentkit.test.mjs",
    "train": "node train.js",
    "corpus": "node data/tutorial/make-corpus.mjs && node data/tutorial/prepare.js",
    "prepare:openwebtext": "node data/openwebtext/prepare.js"
  },
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.22.0",
    "hyparquet": "^1.12.1",
    "js-tiktoken": "^1.0.21"
  }
}
